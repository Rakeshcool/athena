<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Headless core: zero Windows-specific or UI dependencies, so the whole
         engine runs under plain `dotnet test`. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <!-- Direct override: Microsoft.Data.Sqlite 9.0.0 transitively pins
         SQLitePCLRaw.lib.e_sqlite3 2.1.10, whose bundled native SQLite predates
         3.50.2 (CVE-2025-6965, memory corruption). Pinning the lib to the
         patched build closes it; a direct reference wins over the transitive
         pin. Re-check with: dotnet list package, include transitive. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
  </ItemGroup>

</Project>
