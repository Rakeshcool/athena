<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Light palette — layered light surfaces (never pure white everywhere, per
      spec section 7): the window sits on light gray, cards lift one step, hover
      completes the ladder. Text darkens to near-black with the same three-step
      hierarchy as dark; the success green deepens for contrast on light.
      Same keys as Dark.xaml — ThemeApplier merges one or the other.
    -->
    <Color x:Key="AthenaWindowColor">#FFF3F3F3</Color>
    <Color x:Key="AthenaCardColor">#FFFBFBFB</Color>
    <Color x:Key="AthenaCardHoverColor">#FFFFFFFF</Color>
    <Color x:Key="AthenaDividerColor">#FFE0E0E0</Color>
    <SolidColorBrush x:Key="AthenaDividerBrush" Color="{StaticResource AthenaDividerColor}"/>

    <SolidColorBrush x:Key="ApplicationBackgroundColor" Color="{StaticResource AthenaWindowColor}"/>
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource AthenaWindowColor}"/>
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FF1A1A1A"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FF666666"/>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF8A8A8A"/>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource AthenaCardColor}"/>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource AthenaCardHoverColor}"/>
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource AthenaDividerColor}"/>
    <SolidColorBrush x:Key="DividerStrokeColorFillBrush" Color="{StaticResource AthenaDividerColor}"/>
    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="{StaticResource AthenaDividerColor}"/>
    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#FF2E7D32"/>
</ResourceDictionary>
