<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Warm accent — the salmon palette from the UI mockups: salmon highlight
      on near-black, near-black labels on accent, white knob on a salmon
      switch track. See Theme/Athena.xaml for how the variant is consumed and
      ThemeManager for the swap.
    -->
    <Color x:Key="AthenaAccentColor">#FFE89A7A</Color>
    <Color x:Key="AthenaAccentHoverColor">#FFEEAE93</Color>
    <Color x:Key="AthenaAccentTextColor">#FF1A1210</Color>
    <Color x:Key="AthenaSwitchKnobOnColor">#FFF3F3F3</Color>
    <Color x:Key="AthenaSwitchStrokeOnColor">#FFD9825F</Color>
</ResourceDictionary>
