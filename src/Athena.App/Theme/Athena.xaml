<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--
      Athena base palette — near-black surfaces, muted text, hairline dividers
      (shared by every accent variant). ACCENT COLORS LIVE ELSEWHERE:
      Theme/Accents/Neutral.xaml and Theme/Accents/Warm.xaml define the
      AthenaAccent* colors, and ThemeManager merges the active one into the
      application resources at runtime (Settings → Appearance → "Warm accent").

      Everything accent-consuming below MUST use DynamicResource (not
      StaticResource) — a StaticResource would freeze whichever variant was
      merged first and the swap would silently do nothing.
    -->

    <!-- Surfaces + text (shared by both palettes). -->
    <Color x:Key="AthenaWindowColor">#FF161616</Color>
    <Color x:Key="AthenaCardColor">#FF1F1F1F</Color>
    <Color x:Key="AthenaCardHoverColor">#FF292929</Color>
    <Color x:Key="AthenaDividerColor">#FF2E2E2E</Color>
    <SolidColorBrush x:Key="AthenaDividerBrush" Color="{StaticResource AthenaDividerColor}"/>

    <SolidColorBrush x:Key="ApplicationBackgroundColor" Color="{StaticResource AthenaWindowColor}"/>
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource AthenaWindowColor}"/>
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFF3F3F3"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FF9A9A9A"/>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF7A7A7A"/>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource AthenaCardColor}"/>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource AthenaCardHoverColor}"/>
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource AthenaDividerColor}"/>
    <SolidColorBrush x:Key="DividerStrokeColorFillBrush" Color="{StaticResource AthenaDividerColor}"/>
    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="{StaticResource AthenaDividerColor}"/>
    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#FF4C9E63"/>

    <!-- Accent indirection — resolved from the active Theme/Accents/*.xaml. -->
    <SolidColorBrush x:Key="AthenaAccentBrush" Color="{DynamicResource AthenaAccentColor}"/>
    <SolidColorBrush x:Key="AthenaAccentHoverBrush" Color="{DynamicResource AthenaAccentHoverColor}"/>
    <SolidColorBrush x:Key="AthenaAccentTextBrush" Color="{DynamicResource AthenaAccentTextColor}"/>
    <SolidColorBrush x:Key="AthenaAccentTextDisabledBrush" Color="{DynamicResource AthenaAccentTextColor}" Opacity="0.45"/>
    <SolidColorBrush x:Key="AthenaSwitchKnobOnBrush" Color="{DynamicResource AthenaSwitchKnobOnColor}"/>
    <SolidColorBrush x:Key="AthenaSwitchStrokeOnBrush" Color="{DynamicResource AthenaSwitchStrokeOnColor}"/>

    <!-- WPF-UI accent keys → active palette (primary buttons, selection,
         focus rings, ComboBox highlights all follow the swap). -->
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="{DynamicResource AthenaAccentColor}"/>
    <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="{DynamicResource AthenaAccentHoverColor}"/>
    <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="{DynamicResource AthenaAccentHoverColor}"/>
    <SolidColorBrush x:Key="SystemAccentBrush" Color="{DynamicResource AthenaAccentColor}"/>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{DynamicResource AthenaAccentColor}"/>
    <SolidColorBrush x:Key="AccentFillColorPrimaryBrush" Color="{DynamicResource AthenaAccentColor}"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{DynamicResource AthenaAccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{DynamicResource AthenaAccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{DynamicResource AthenaAccentTextColor}"/>
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="{DynamicResource AthenaAccentTextColor}"/>
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="{DynamicResource AthenaAccentTextColor}"/>
    <SolidColorBrush x:Key="AccentControlElevationBorderBrush" Color="{DynamicResource AthenaAccentColor}"/>

    <!-- Toggle switch ON state — accent fill with the palette's knob color. -->
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{DynamicResource AthenaAccentColor}"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{DynamicResource AthenaAccentHoverColor}"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled" Color="{DynamicResource AthenaAccentColor}" Opacity="0.4"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{DynamicResource AthenaSwitchStrokeOnColor}"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="{DynamicResource AthenaSwitchStrokeOnColor}"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="{DynamicResource AthenaSwitchKnobOnColor}"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="{DynamicResource AthenaSwitchKnobOnColor}"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="{DynamicResource AthenaSwitchKnobOnColor}"/>

    <!-- Primary button: accent fill, palette-appropriate label, 8px radius.
         (Key name kept from the neutral-only build; setters are DynamicResource
         so the button re-skins with the accent swap.) -->
    <Style x:Key="PrimaryNeutralButton" TargetType="ui:Button">
        <Setter Property="Background" Value="{DynamicResource AthenaAccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AthenaAccentTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,6"/>
    </Style>

    <Style BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}" TargetType="ui:ToggleSwitch"/>

    <Style x:Key="RowDivider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{StaticResource AthenaDividerBrush}"/>
        <Setter Property="Margin" Value="0,10"/>
    </Style>
</ResourceDictionary>
