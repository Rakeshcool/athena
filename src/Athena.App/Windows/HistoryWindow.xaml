<ui:FluentWindow x:Class="Athena.App.Windows.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Athena History" Width="720" Height="560"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <ui:FluentWindow.Resources>
        <Style x:Key="CardContainer" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter Margin="0,0,0,8"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Meta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.55"/>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="History" Padding="12,6,0,0" Height="40"/>

        <Grid Grid.Row="1" Margin="16,0,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ui:TextBox Grid.Row="0" x:Name="SearchBox" PlaceholderText="Search transcripts…"
                        KeyUp="OnSearchKey" Margin="0,2,0,10"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                <ui:ToggleSwitch x:Name="RawToggle" Content="Show raw transcripts"
                                 Checked="OnToggleChanged" Unchecked="OnToggleChanged"/>
            </StackPanel>

            <ListBox x:Name="HistoryList" Grid.Row="2"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Background="Transparent" BorderThickness="0"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     ItemContainerStyle="{StaticResource CardContainer}"
                     SelectionChanged="OnSelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" FontSize="14"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Style="{StaticResource Meta}"
                                               Text="{Binding StartedAt, StringFormat=yyyy-MM-dd HH:mm:ss}"/>
                                    <TextBlock Style="{StaticResource Meta}" Text="{Binding Status}" Margin="10,0,0,0"/>
                                    <TextBlock Style="{StaticResource Meta}" Text="{Binding TargetAppName}" Margin="10,0,0,0"/>
                                    <TextBlock Style="{StaticResource Meta}" Text="{Binding DurationText}" Margin="10,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                <ui:Button x:Name="PlayButton" Content="Play audio" Click="OnPlayAudio" Padding="12,6"/>
                <ui:Button Content="Copy" Click="OnCopy" Padding="12,6" Margin="8,0,0,0"/>
                <ui:Button Content="Retry" Click="OnRetry" Padding="12,6" Margin="8,0,0,0" Appearance="Primary"/>
                <ui:Button Content="Delete" Click="OnDelete" Padding="12,6" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
