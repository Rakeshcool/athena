<ui:FluentWindow x:Class="Athena.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Athena.App.Windows"
        Title="Athena Settings" Width="640" Height="580"
        Icon="/Assets/Athena.ico"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <ui:FluentWindow.Resources>
        <!-- Pill tabs: flat TabItems, active tab gets a muted fill. -->
        <Style x:Key="PillTab" TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Pill" CornerRadius="8" Padding="12,6" Margin="0,0,8,0"
                                Background="Transparent">
                            <ContentPresenter x:Name="TabHeader" ContentSource="Header" TextElement.FontSize="13"
                                              TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Pill" Property="Background"
                                        Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                <Setter TargetName="TabHeader" Property="TextElement.Foreground"
                                        Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabHeader" Property="TextElement.Foreground"
                                        Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Section label: weight 500, sentence case. -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,14,0,2"/>
        </Style>
        <Style x:Key="HelpText" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <!-- Dictionary table: the stock ListView/GridView chrome is system white
             and ignores the dark theme — flat dark rows, hairline dividers,
             quiet headers instead. -->
        <Style x:Key="DictHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border BorderBrush="{DynamicResource AthenaDividerBrush}"
                                BorderThickness="0,0,0,1" Padding="0,0,12,6">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="12" FontWeight="Medium"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DictRow" TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Padding" Value="0,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Row" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="{DynamicResource AthenaDividerBrush}" BorderThickness="0,0,0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource ControlFillColorDefaultBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Athena settings" Padding="12,6,0,0" Height="40">
            <ui:TitleBar.Header>
                <TextBlock x:Name="SavedTick" Text="saved" FontSize="12" Opacity="0"
                           Margin="10,0,0,0" VerticalAlignment="Center"/>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="16,4,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TabControl x:Name="PillTabs" Grid.Row="0" Background="Transparent"
                        BorderThickness="0" Margin="0,0,0,4">
                <TabItem Style="{StaticResource PillTab}" Header="General"/>
                <TabItem Style="{StaticResource PillTab}" Header="Servers"/>
                <TabItem Style="{StaticResource PillTab}" Header="Dictionary"/>
                <TabItem Style="{StaticResource PillTab}" Header="About"/>
            </TabControl>

            <!-- Pages scroll; tab bar and Save bar stay pinned. The pages are
                 direct children (code-behind toggles Visibility by name) inside
                 one content Grid, so exactly one is visible at a time.
                 VerticalScrollBarVisibility=Auto: no scrollbar chrome until
                 content actually overflows. -->
            <!-- Auto keeps the bar's layout slot stable (no reflow); the
                 helper fades it in on activity and out after 900ms idle. -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          local:AutoHideScrollBarHelper.Enabled="True"
                          Padding="0,0,4,0">
            <Grid>

            <!-- General: mockup row layout — title + muted sublabel left,
                 toggle right, hairline dividers between rows. -->
            <StackPanel x:Name="GeneralPage" Visibility="Collapsed" Margin="0,4,0,0">
                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Clean up my speech automatically" FontSize="13"/>
                        <TextBlock Text="Removes 'um's and stumbles, adds punctuation. 'Meet at 1… no, make it 2pm' becomes 'Meet at 2pm.'" FontSize="12" Opacity="0.55" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" x:Name="CleanupToggle" VerticalAlignment="Center"/>
                </Grid>
                <Border Style="{StaticResource RowDivider}"/>
                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Sound effects" FontSize="13"/>
                        <TextBlock Text="Play a short sound when you start, stop, and when your text is ready" FontSize="12" Opacity="0.55" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" x:Name="SoundsToggle" VerticalAlignment="Center"/>
                </Grid>
                <Border Style="{StaticResource RowDivider}"/>
                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Show words while I'm speaking" FontSize="13"/>
                        <TextBlock Text="See your speech turn into text live, before the key is released" FontSize="12" Opacity="0.55" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" x:Name="StreamingToggle" VerticalAlignment="Center"/>
                </Grid>
                <Border Style="{StaticResource RowDivider}"/>
                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Type text as soon as I release the key" FontSize="13"/>
                        <TextBlock Text="On: fastest. Off (recommended): re-checks the full recording first, so fewer mistakes — takes a moment longer" FontSize="12" Opacity="0.55" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" x:Name="FileFallbackToggle" VerticalAlignment="Center"/>
                </Grid>
                <Border Style="{StaticResource RowDivider}"/>
                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Double-check the first word" FontSize="13"/>
                        <TextBlock Text="The first word is the easiest to mishear ('write' heard as 'right'). Works only with the option above turned on" FontSize="12" Opacity="0.55" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" x:Name="CrossCheckToggle" VerticalAlignment="Center"/>
                </Grid>
                <Border Style="{StaticResource RowDivider}"/>
                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Capture system audio" FontSize="13"/>
                        <TextBlock Text="Also transcribe what your computer is playing — meeting calls, YouTube, Spotify. Hold the key for both your voice and the audio; tap the key then Space for the audio only" FontSize="12" Opacity="0.55" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" x:Name="SystemAudioToggle" VerticalAlignment="Center"/>
                </Grid>

                <TextBlock Style="{StaticResource SectionLabel}" Text="Speech language"/>
                <ComboBox x:Name="LanguageBox" Margin="0,6,0,0"/>

                <TextBlock Style="{StaticResource SectionLabel}" Text="Dictation key"/>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HotkeyDisplay" Text="` (backtick)" FontSize="13"
                               VerticalAlignment="Center"/>
                    <ui:Button x:Name="RebindButton" Grid.Column="1" Content="Change key"
                               Click="OnRebindClick" Padding="12,5" Margin="8,0,0,0"/>
                </Grid>
                <TextBlock Style="{StaticResource HelpText}"
                           Text="Hold the key while you speak, release to type. Tap Space to keep talking without holding it. Press Esc to throw away a take."/>

                <TextBlock Style="{StaticResource SectionLabel}" Text="Launch"/>
                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Start Athena when Windows starts" FontSize="13"/>
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" x:Name="LaunchAtLoginToggle" VerticalAlignment="Center"/>
                </Grid>

                <TextBlock Style="{StaticResource SectionLabel}" Text="Appearance"/>
                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Warm color theme" FontSize="13"/>
                        <TextBlock Text="Softer salmon highlights instead of white" FontSize="12" Opacity="0.55" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" x:Name="WarmAccentToggle" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>

            <!-- Servers -->
            <StackPanel x:Name="ServersPage" Visibility="Collapsed" Margin="0,4,0,0">
                <TextBlock Style="{StaticResource SectionLabel}" Text="Local Nemotron ASR server URL"/>
                <ui:TextBox x:Name="AsrUrlBox" Margin="0,6,0,12" MaxWidth="420" HorizontalAlignment="Left"/>
                <TextBlock Style="{StaticResource SectionLabel}" Text="Local llama.cpp LLM server URL"/>
                <ui:TextBox x:Name="LlmUrlBox" Margin="0,6,0,12" MaxWidth="420" HorizontalAlignment="Left"/>
                <TextBlock Style="{StaticResource SectionLabel}" Text="LLM model (optional; blank = server default)"/>
                <ui:TextBox x:Name="LlmModelBox" Margin="0,6,0,12" MaxWidth="420" HorizontalAlignment="Left"/>
                <ui:Button x:Name="TestServersButton" Content="Test connection" Click="OnTestServers"
                           Width="140" HorizontalAlignment="Left" Appearance="Primary"/>
                <TextBlock x:Name="ServerStatus" Opacity="0.7" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Dictionary -->
            <Grid x:Name="DictionaryPage" Visibility="Collapsed" Margin="0,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <!-- Auto, not *: star rows collapse to zero inside the
                         page ScrollViewer (infinite measure height). The list
                         gets a fixed max and scrolls internally instead. -->
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource HelpText}"
                           Text="Terms spell jargon correctly in the transcript. Replacements enforce wrong → right after the model — the dictionary's guarantee."/>
                <Grid Grid.Row="1" Margin="0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="NewTermBox" Grid.Column="0" Margin="0,0,4,0" PlaceholderText="Term or wrong word"/>
                    <ui:TextBox x:Name="NewRightBox" Grid.Column="1" Margin="0,0,4,0" PlaceholderText="Correct spelling"/>
                    <ui:Button x:Name="AddTermButton" Grid.Column="2" Content="Add term" Click="OnAddTerm" Padding="10,4"/>
                    <ui:Button x:Name="AddRuleButton" Grid.Column="3" Content="Add replacement" Click="OnAddRule" Padding="10,4" Margin="6,0,0,0"/>
                </Grid>
                <ListView x:Name="DictList" Grid.Row="2" FontSize="12"
                          Background="Transparent" BorderThickness="0"
                          MaxHeight="240"
                          ItemContainerStyle="{StaticResource DictRow}">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource DictHeader}">
                            <GridViewColumn Header="Term / wrong" Width="220" DisplayMemberBinding="{Binding Left}"/>
                            <GridViewColumn Header="Replacement" Width="220" DisplayMemberBinding="{Binding Right}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                    <ui:Button Content="Remove selected" Click="OnRemoveSelected" Padding="10,4"/>
                    <ui:Button Content="Import CSV…" Click="OnImportCsv" Padding="10,4" Margin="8,0,0,0"/>
                    <ui:Button Content="Export CSV…" Click="OnExportCsv" Padding="10,4" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>

            <!-- About -->
            <StackPanel x:Name="AboutPage" Visibility="Collapsed" Margin="0,4,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Image Source="/Assets/Athena.ico" Width="32" Height="32"
                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Athena for Windows" FontSize="18" FontWeight="Medium"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <TextBlock TextWrapping="Wrap" Margin="0,8" Opacity="0.7"
                           Text="Hold a key, speak, and polished text lands at your cursor — fully local. Nemotron ASR + llama.cpp cleanup, no cloud, no accounts."/>
                <TextBlock TextWrapping="Wrap" Opacity="0.7"
                           Text="Audio is on disk before any transcription starts, every failure is retryable from History, and transcripts never leave this machine."/>
            </StackPanel>
            </Grid>
            </ScrollViewer>

            <!-- Bottom bar: explicit Save (mockup), persistent across tabs. -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                <ui:Button x:Name="SaveButton" Content="Save" Click="OnSaveClick"
                           Style="{StaticResource PrimaryNeutralButton}" MinWidth="84"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
