<Window x:Class="Jot.App.Windows.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jot History" Width="720" Height="560"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Grid.Column="0"
                     VerticalContentAlignment="Center"
                     KeyUp="OnSearchKey"/>
            <CheckBox x:Name="RawToggle" Grid.Column="1" Content="Raw" Margin="8,0,0,0"
                      VerticalAlignment="Center" Checked="OnToggleChanged" Unchecked="OnToggleChanged"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                <Button x:Name="PlayButton" Content="▶ Play audio" Click="OnPlayAudio" Padding="8,3"/>
                <Button Content="Copy" Click="OnCopy" Padding="8,3" Margin="6,0,0,0"/>
                <Button Content="Retry" Click="OnRetry" Padding="8,3" Margin="6,0,0,0"/>
                <Button Content="Delete" Click="OnDelete" Padding="8,3" Margin="6,0,0,0"/>
            </StackPanel>
        </Grid>

        <ListBox x:Name="HistoryList" Grid.Row="1" FontSize="13"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="OnSelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="6,4">
                        <StackPanel>
                            <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" FontWeight="Medium"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding StartedAt, StringFormat=yyyy-MM-dd HH:mm:ss}"
                                           Foreground="Gray" FontSize="11"/>
                                <TextBlock Text="{Binding Status}" Foreground="Gray" FontSize="11" Margin="10,0,0,0"/>
                                <TextBlock Text="{Binding TargetAppName}" Foreground="Gray" FontSize="11" Margin="10,0,0,0"/>
                                <TextBlock Text="{Binding DurationText}" Foreground="Gray" FontSize="11" Margin="10,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
