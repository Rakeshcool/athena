<Window x:Class="Jot.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jot Settings" Width="640" Height="560"
        WindowStartupLocation="CenterScreen">
    <TabControl Margin="10">
        <TabItem Header="General">
            <StackPanel Margin="8">
                <CheckBox x:Name="CleanupToggle" Content="Polish transcripts with the local LLM (self-corrections, punctuation, fillers)"
                          Margin="0,4" IsChecked="True"/>
                <CheckBox x:Name="SoundsToggle" Content="Play earcons on start/stop/success/error"
                          Margin="0,4" IsChecked="True"/>
                <Separator Margin="0,10"/>
                <Separator Margin="0,10"/>
                <TextBlock Text="Speech language" FontWeight="SemiBold"/>
                <TextBlock Text="The language you dictate in. Used by the ASR model (streaming and file paths)."
                           TextWrapping="Wrap" Foreground="Gray" Margin="0,2"/>
                <ComboBox x:Name="LanguageBox" Margin="0,6,0,4" Width="280" HorizontalAlignment="Left"/>

                <Separator Margin="0,10"/>
                <TextBlock Text="Push-to-talk key" FontWeight="SemiBold"/>
                <TextBlock Text="Hold ` (backtick) to talk. Hold + Space locks hands-free. Ctrl/Alt/Win+` passes through to apps."
                           TextWrapping="Wrap" Foreground="Gray" Margin="0,2"/>
                <Separator Margin="0,10"/>
                <TextBlock Text="Launch" FontWeight="SemiBold"/>
                <CheckBox x:Name="LaunchAtLoginToggle" Content="Start Jot when Windows starts"
                          Margin="0,4"/>
            </StackPanel>
        </TabItem>

        <TabItem Header="Servers">
            <StackPanel Margin="8">
                <TextBlock Text="Local Nemotron ASR server URL"/>
                <TextBox x:Name="AsrUrlBox" Margin="0,4,0,12" Text="http://127.0.0.1:8080"/>
                <TextBlock Text="Local llama.cpp LLM server URL"/>
                <TextBox x:Name="LlmUrlBox" Margin="0,4,0,12" Text="http://127.0.0.1:3000"/>
                <TextBlock Text="LLM model (optional; blank = server default)"/>
                <TextBox x:Name="LlmModelBox" Margin="0,4,0,12"/>
                <Button x:Name="TestServersButton" Content="Test connection" Width="140"
                        HorizontalAlignment="Left" Click="OnTestServers"/>
                <TextBlock x:Name="ServerStatus" Foreground="Gray" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </TabItem>

        <TabItem Header="Dictionary">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="Gray"
                           Text="Terms spell jargon correctly in the transcript. Replacements enforce wrong → right after the model — the dictionary's guarantee."/>
                <Grid Grid.Row="1" Margin="0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewTermBox" Grid.Column="0" Margin="0,0,4,0"/>
                    <TextBox x:Name="NewRightBox" Grid.Column="1" Margin="0,0,4,0"/>
                    <Button x:Name="AddTermButton" Grid.Column="2" Content="Add term" Click="OnAddTerm" Padding="8,3"/>
                    <Button x:Name="AddRuleButton" Grid.Column="3" Content="Add replacement" Click="OnAddRule" Padding="8,3"/>
                </Grid>
                <ListView x:Name="DictList" Grid.Row="2" FontSize="12">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Term / wrong" Width="220" DisplayMemberBinding="{Binding Left}"/>
                            <GridViewColumn Header="Replacement" Width="220" DisplayMemberBinding="{Binding Right}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8">
                    <Button Content="Remove selected" Click="OnRemoveSelected" Padding="8,3"/>
                    <Button Content="Import CSV…" Click="OnImportCsv" Padding="8,3" Margin="8,0,0,0"/>
                    <Button Content="Export CSV…" Click="OnExportCsv" Padding="8,3" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </TabItem>

        <TabItem Header="About">
            <StackPanel Margin="8">
                <TextBlock Text="Jot for Windows" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock TextWrapping="Wrap" Margin="0,8" Foreground="Gray"
                           Text="Hold a key, speak, and polished text lands at your cursor — fully local. Nemotron ASR + llama.cpp cleanup, no cloud, no accounts."/>
                <TextBlock TextWrapping="Wrap" Foreground="Gray"
                           Text="Audio is on disk before any transcription starts, every failure is retryable from History, and transcripts never leave this machine."/>
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>
